const checkbagahe = function (materials) {
  const bagahe = materials.toLowerCase();
  if (
    bagahe.includes("Knife") ||
    bagahe.includes("knife") ||
    bagahe.includes("Gun") ||
    bagahe.includes("gun")
  ) {
    console.log("your are not a welcome this airport ");
  } else {
    console.log("welcome airport");
  }
};

